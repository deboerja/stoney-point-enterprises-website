---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy";
const description =
  "A concise privacy notice for this static informational website: no advertising trackers, no behavioral analytics, no user accounts, and no web-form data collection.";
---

<BaseLayout title={title} description={description} current="">
  <section class="hero section-dark section-tight">
    <div class="container">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy notice</h1>
      <p class="lede">Last updated: July 2026.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>This website is a static, informational site. In short:</p>
      <ul>
        <li>We do not intentionally use advertising trackers.</li>
        <li>We do not intentionally use behavioral analytics.</li>
        <li>We do not use public user accounts.</li>
        <li>We do not collect information through a web form &mdash; there isn't one.</li>
        <li>
          Contact initiated through email is handled through the sender's
          email provider and Stoney Point Enterprises' company email
          service, like any other email.
        </li>
      </ul>

      <h2>Hosting infrastructure</h2>
      <p>
        This site is served as static files through standard web-hosting
        infrastructure. Like essentially any web server, that infrastructure
        may process ordinary technical request information &mdash; such as IP
        addresses and browser metadata &mdash; as part of normal HTTP request
        handling. This is standard hosting-provider operation, distinct from
        anything Stoney Point Enterprises itself collects, stores, or
        analyzes. We do not operate a separate analytics or tracking layer
        on top of it.
      </p>

      <h2>Changes to this notice</h2>
      <p>
        This privacy notice may be updated as the site evolves. Material
        changes will be reflected by updating the date at the top of this
        page.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this notice can be sent to
        <a href="mailto:Jacob.Deboer@stoneypointenterprises.com">Jacob.Deboer@stoneypointenterprises.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
