---
const { current = "" } = Astro.props;

const links = [
  { href: "/", label: "Home", key: "home" },
  { href: "/about", label: "About", key: "about" },
  { href: "/capabilities", label: "Capabilities", key: "capabilities" },
  { href: "/projects", label: "Projects", key: "projects" },
  { href: "/security", label: "Security", key: "security" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-lockup" href="/">
      <img src="/logo-mark.png" alt="" width="36" height="36" />
      <span>
        Stoney Point Enterprises
        <span class="brand-sub">Applied AI &amp; Data Systems</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      Menu
    </button>

    <nav class="main-nav" id="primary-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
